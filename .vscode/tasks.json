{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build sln",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/RecursiveParsing.slnx",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "build proj",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/RecursiveParsing.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "build lib",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/lib/ebnf/EBNFParser.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "parse EBNF",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/RecursiveParsing.csproj",
                "-t:ParseEBNF"
            ],
            "problemMatcher": "$msCompile",
            "dependsOn":[
                "build lib"
            ]
        },
        {
            "label": "make",
            "command": "wsl",
            "type": "process",
            "args": [
                "--exec",
                "make",
                // "-B",
                "run",
            ],
            "problemMatcher": "$msCompile",
        },
    ]
}
