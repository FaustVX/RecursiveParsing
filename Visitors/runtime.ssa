function w $_rand_min_max(w %min, w %max) {
@start
    %range =w sub %max, %min
    %rand =w call $_rand_max(w %range)
    %rand =w add %rand, %min
    ret %rand
}

function w $_rand_max(w %max) {
@start
    %rand =w call $rand()
    %rand =w rem %rand, %max
    ret %rand
}

function w $_rand() {
@start
    %rand =w call $rand()
    ret %rand
}

function $_srand() {
@start
    %time =l call $_time()
    call $srand(l %time)
    ret 
}

function w $_time() {
@start
    %time =w call $time(l 0)
    ret %time
}

data $_newline = { b "\n", b 0 }
data $_int_fmt = { b "%d", b 0 }
data $_str_fmt = { b "%s", b 0 }
data $_bool_fmt = { b "%b", b 0 }
data $_true_literal = { b "true", b 0 }
data $_false_literal = { b "false", b 0 }
