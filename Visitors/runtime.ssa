function $_call_n_w(l %fun, w %arg1) {
@start
    call %fun(w %arg1)
    ret
}

function $_call_n_l(l %fun, l %arg1) {
@start
    call %fun(l %arg1)
    ret
}

data $_newline = { b "\n", b 0 }
data $_int_fmt = { b "%d", b 0 }
data $_str_fmt = { b "%s", b 0 }
data $_bool_fmt = { b "%b", b 0 }
data $_true_literal = { b "true", b 0 }
data $_false_literal = { b "false", b 0 }
